# systemd unit: sudo cp deploy/vault.service /etc/systemd/system/ && sudo systemctl enable --now vault
# Assumes the project in /opt/vault, a virtualenv in /opt/vault/.venv and a system user "vault".
[Unit]
Description=VAULT
After=network.target mysql.service mariadb.service

[Service]
User=vault
Group=vault
WorkingDirectory=/opt/vault
# 127.0.0.1 = reachable only through the reverse proxy (deploy/nginx-dbms.conf). Use 0.0.0.0 for plain LAN access.
ExecStart=/opt/vault/.venv/bin/python manage.py serve --host 127.0.0.1 --port 8495
Restart=on-failure
RestartSec=5
# Keep the process away from the rest of the system. FreeRADIUS is restarted through sudo
# (deploy/radius/sudoers-dbms.example), so NoNewPrivileges must stay off.
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
