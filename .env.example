# Copy to .env and edit. Every line is optional.
# SAFE DEFAULTS: the server listens on 127.0.0.1 only, /admin is off, setup works only on the server PC.

# --- where data lives (database, backups, secret.key, session.key, known_hosts) ---
# Optional: set an absolute path for persistent data. Examples:
# Windows: DBMS_DATA=C:\ProgramData\DeviceBackup
# Linux:   DBMS_DATA=/var/lib/dbms
# If omitted, data/ inside the project directory is used.

# --- Database ---
# MySQL 8.0 / MariaDB 10.6+ only (create the database with utf8mb4 first, see README).
DBMS_DB_ENGINE=mysql
# Required for mysql. Use a strong, unique password; it is read from here only, never from the code.
DBMS_DB_NAME=dbms
DBMS_DB_USER=dbms
DBMS_DB_PASSWORD=change-me
DBMS_DB_HOST=127.0.0.1
DBMS_DB_PORT=3306

# --- Django ---
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=          # leave empty: a key is created in the data folder
# Names/IPs people type in the browser, e.g. your static public IP or domain (never use *):
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1   # add your server IP / domain here
# Add the exact public IP/domain used in the browser; never use *
# Must match what the browser shows, including https://  e.g. https://203.0.113.10  or  https://backup.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://backup.example.com
TIME_ZONE=Asia/Dhaka          # fixed by the application; do not change for Bangladesh operations

# --- HTTPS behind a reverse proxy (Caddy / nginx on THIS PC, see deploy/windows/Caddyfile) ---
# Set all four when the proxy is in front and HTTPS works:
# DBMS_BEHIND_PROXY=1
# DBMS_SECURE_COOKIES=1
# DBMS_FORCE_HTTPS=1

# --- web server (python manage.py serve) ---
# HOST=127.0.0.1             # use 0.0.0.0 ONLY for plain LAN access without a proxy
# PORT=8000

# --- extra protection (recommended for an internet-facing server) ---
# Only allow devices inside your management networks (comma separated CIDR). Stops a stolen
# operator account from pointing the server (and your switch passwords) at an attacker's host.
# Private management networks are allowed by this starter configuration.
# Add your REAL public management IPs as /32 entries or their assigned management CIDRs.
DBMS_RECONNECT_RETRY_SECONDS=60
# 1 = remember each switch's SSH host key on first contact and refuse a changed key.
DBMS_SSH_HOSTKEY_CHECK=1
# 1 = administrators' browsers receive saved switch passwords to auto-fill the device form (not recommended).
# Admin-only saved credential auto-fill is enabled to support the device edit form; set 0 to disable.
# 1 = enable Django's /admin/ site (not needed; it bypasses roles and has no login lockout).
# DBMS_ENABLE_ADMIN=0
# 1 = allow the first-administrator page from other computers (default: only on the server PC).
# DBMS_SETUP_FROM_ANYWHERE=0

# --- behaviour ---
WORKERS=10                        # parallel SSH sessions (Settings page value wins, 1 to 50)
# DBMS_KEEP_VERSIONS=0        # keep newest N backups per device, 0 = all
# DBMS_SSH_TIMEOUT=30         # SSH connect/auth/banner timeout in seconds
# Patient backups (docs/BACKUP_RELIABILITY.md): wait while a device sends, give up when it goes silent
# DBMS_COMMAND_IDLE_SECONDS=180   # give up when the device sends nothing for this long
# DBMS_COMMAND_TIMEOUT=3600       # longest time for one device's configuration (ceiling)
# DBMS_LOGIN_SPACING=0.5          # seconds between two new SSH logins (0 = off)
# DBMS_RETRY_PASS=1               # second try inside the job for temporary failures (0 = off)
# DBMS_RETRY_COOLDOWN=60          # seconds before that second try
# DBMS_RETRY_PASS_WORKERS=3       # parallel sessions in the second try
# DBMS_RETRY_MAX_DAYS=7           # how long an offline device is waited for
# DBMS_SLOW_DEVICES=0         # 1 = more patient CLI handling
# DBMS_ALLOWED_NETWORKS=10.0.0.0/8,103.28.121.0/24   # SSH and ping only to these networks (unset = any)
# DBMS_REVEAL_PASSWORDS=0     # 0 = saved device passwords are never sent to a browser
DBMS_PING_SECONDS=300         # full-inventory ICMP scan every 5 minutes (lower server load)
DBMS_PING_WORKERS=20          # parallel ICMP checks; bounded to 40
DBMS_PING_TIMEOUT_MS=1500     # wait up to 1.5 seconds for each ICMP attempt
DBMS_PING_ATTEMPTS=2          # 2 attempts + a second round for failed hosts: no false "offline" dips
# DBMS_SESSION_MINUTES=30  # idle timeout; browser-close also ends the session
# LOG_LEVEL=INFO

# --- optional backup failure alerts (leave blank to disable) ---
# Telegram bot token and chat ID; never share these credentials publicly.
# DBMS_TELEGRAM_BOT_TOKEN=
# DBMS_TELEGRAM_CHAT_ID=
# Comma-separated email recipients. Configure SMTP below if using email alerts.
# DBMS_ALERT_EMAILS=network-team@example.com,admin@example.com
# DBMS_EMAIL_HOST=smtp.example.com
# DBMS_EMAIL_PORT=587
# DBMS_EMAIL_USER=dbms@example.com
# DBMS_EMAIL_PASSWORD=
# DBMS_EMAIL_USE_TLS=1
# DBMS_EMAIL_USE_SSL=0
# DBMS_EMAIL_FROM=dbms@example.com

# Large inventories: persist progress after every N completed devices (1-25).
DBMS_PROGRESS_BATCH=5

# --- RADIUS Admin (menu: RADIUS Admin -> Users / Devices / Audit) ---
# The MariaDB/MySQL database that FreeRADIUS uses (radcheck, radusergroup, nas, radpostauth ...).
RADIUS_DB_NAME=radius
RADIUS_DB_USER=radius
RADIUS_DB_PASSWORD=change-me
RADIUS_DB_HOST=127.0.0.1
RADIUS_DB_PORT=3306
# cleartext (default) or ssha2 = salted SHA-256 for passwords set from now on (PAP logins only; test first).
# RADIUS_PASSWORD_MODE=cleartext
# Command run after a RADIUS device is added or removed (see deploy/radius/sudoers-dbms.example).
# RADIUS_RELOAD_CMD=sudo -n /usr/bin/systemctl restart freeradius
# Keep UDP 1812/1813 open in ufw only for NAS Clients devices (set by deploy/radius/enable_firewall_sync.sh)
# RADIUS_FIREWALL_CMD=sudo -n /usr/local/sbin/vault-radius-firewall
